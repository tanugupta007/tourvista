# Copy this file to backend/.env. Keep real credentials private and never commit .env.
PORT=5124

# ---------- AI assistant (any OpenAI-compatible provider) ----------
# Option 1 (hosted): Groq -> https://console.groq.com/keys
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-20b
AI_API_KEY=

# Option 2 (free, hosted): OpenRouter free models
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=<any model id ending in :free>
# AI_API_KEY=your_key_here

# Option 3 (100% free & local, no key): Ollama  ->  https://ollama.com  then run: ollama pull llama3.2
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.2
# AI_API_KEY=

# ---------- Map services (defaults are the free public OpenStreetMap services) ----------
# Nominatim's policy requires an identifying User-Agent. Use your project name + contact email.
GEO_USER_AGENT=TourVista/1.0 (you@example.com)
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# ROUTE_URL_DRIVING=https://router.project-osrm.org/route/v1/driving
# ROUTE_URL_WALKING=https://routing.openstreetmap.de/routed-foot/route/v1/driving
# ROUTE_URL_CYCLING=https://routing.openstreetmap.de/routed-bike/route/v1/driving

# ---------- Payment (not implemented; do not add credentials until a real server checkout exists) ----------
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# PHONEPE_MERCHANT_ID=
# PHONEPE_SALT_KEY=
# PAYTM_MID=
# PAYTM_MERCHANT_KEY=
